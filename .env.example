SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Demo toggles
DEMO_MODE=true
ENABLE_AUTH=false
ENABLE_REAL_PAYMENTS=false
ENABLE_REAL_CHAT=false

# Email (used only when demo mode is disabled)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=your-app-password

# Stripe (only required when ENABLE_REAL_PAYMENTS=true)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_QUARTERLY=
STRIPE_PRICE_ID_YEARLY=

# OpenAI (only required when ENABLE_REAL_CHAT=true)
OPENAI_API_KEY=

# Optional demo overrides
DEMO_PRICE_MONTHLY=€9 / month
DEMO_PRICE_QUARTERLY=€24 / 3 months
DEMO_PRICE_YEARLY=€79 / year

# Deployment utilities
# CSRF_TRUSTED_ORIGINS=https://your-demo.onrender.com
# TIME_ZONE=UTC

